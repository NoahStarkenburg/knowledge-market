# Frontend environment variables — EXAMPLE FILE (safe to commit).
#
# Copy this to `.env.local` and fill in real values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored. This file is not, because its whole job is to
# document which variables exist without carrying any real values.
#
#
# ===========================================================================
# READ THIS BEFORE ADDING A VARIABLE
# ===========================================================================
# Everything here is PUBLIC.
#
# Vite does not "inject" these at runtime. At build time it performs a literal
# text substitution: every `import.meta.env.VITE_FOO` in your source is
# replaced with the value, and that value is baked into the JavaScript bundle
# shipped to the browser. Anyone can read it — devtools, View Source, or
# curl on your bundle.
#
# So the rule is absolute: a real secret can NEVER live in a VITE_ variable.
# Not obfuscated, not base64'd, not "only in production". If the browser can
# use it, the user can read it.
#
# Only two kinds of value belong here:
#   1. Values that are public by design (a Stripe publishable key, an OAuth
#      client ID) — these identify your app, they do not authorize actions.
#   2. Values that are not sensitive at all (a base URL, a feature flag).
#
# Anything that grants access — a Stripe secret key, a JWT signing key, a
# database password — belongs on the SERVER, in .NET user-secrets locally or
# environment variables in production. See the README.
# ===========================================================================


# Base URL of the backend API.
# Not a secret; it is visible in every network request the browser makes.
VITE_API_BASE_URL=http://localhost:5116

# Stripe publishable key. PUBLIC BY DESIGN — Stripe intends this to ship to
# the browser. It can start a checkout but cannot read your account or move
# money. Its partner, the secret key (sk_...), must never appear in this file.
# Test-mode keys start with pk_test_.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key

# Feature flag: show the "Sign in with Google" button. Not a secret.
VITE_GOOGLE_AUTH=false

# Google OAuth client ID. Public by design — it identifies your app to Google.
# The matching client SECRET stays on the server and is never set here.
VITE_GOOGLE_CLIENT_ID=

# Google Picker API key, used for the Drive import feature. Restrict this key
# by HTTP referrer in Google Cloud Console; that referrer restriction, not
# secrecy, is what protects it.
VITE_GOOGLE_API_KEY=
