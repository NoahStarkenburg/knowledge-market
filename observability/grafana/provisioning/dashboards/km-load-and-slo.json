{
  "uid": "km-load-slo",
  "title": "KnowledgeMarket - load tests and SLOs",
  "tags": [
    "knowledgemarket",
    "k6",
    "slo"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "k6 test",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(k6_vus, testid)",
          "refId": "q"
        },
        "definition": "label_values(k6_vus, testid)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Service level objectives",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Availability (5m)",
      "id": 2,
      "description": "Share of API requests that did not return 5xx over the last 5 minutes. Objective: 99.5%.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - km:slo_error_ratio:rate5m",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Burn rate (1h)",
      "id": 3,
      "description": "How fast the 30-day error budget is being spent, judged on the last hour. 1 is exactly on budget; 14.4 pages someone.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "x",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 14.4
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "km:slo_burn_rate:1h",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ]
    },
    {
      "type": "stat",
      "title": "Budget this range would use",
      "id": 4,
      "description": "If all 30 days looked like the selected time range, the share of the error budget they would use. Over 100% misses the objective.",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(increase(http_server_request_duration_count{job=\"KnowledgeMarket.Api\", http_route!~\"/health.*\", http_response_status_code=~\"5..\"}[$__range])) or vector(0)) / sum(increase(http_server_request_duration_count{job=\"KnowledgeMarket.Api\", http_route!~\"/health.*\"}[$__range])) / 0.005",
          "datasource": {
            "type": "prometheus",
            "uid": "mimir"
          }
        }
      ]
    },
