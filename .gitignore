# .gitignore — everything git should never track.
#
# Rules are matched top to bottom. A trailing slash means "directory".
# A leading ! un-ignores something an earlier rule caught.


# ---------------------------------------------------------------------------
# .NET build output
# ---------------------------------------------------------------------------
# Compiled assemblies and intermediate files. Regenerated by `dotnet build`,
# machine-specific, and large. Never useful to another developer.
bin/
obj/

# ---------------------------------------------------------------------------
# Frontend build output and dependencies
# ---------------------------------------------------------------------------
# node_modules is restored from package-lock.json. Committing it would add
# tens of thousands of files and still not be reproducible across platforms.
node_modules/

# Vite's production bundle. Generated by `npm run build`.
dist/

# TypeScript incremental compilation cache.
*.tsbuildinfo


# ---------------------------------------------------------------------------
# Secrets — the section that matters most
# ---------------------------------------------------------------------------
# Real environment files. These hold actual values and must never be committed.
.env
.env.local
.env.*.local

# ...but DO track the example file, which documents which variables exist
# using dummy values. The ! re-includes it after the rules above caught it.
!.env.example

# Certificates and private keys.
*.pfx
*.p12
*.pem
*.key

# ASP.NET Core Data Protection key ring. These XML files hold the AES-256
# master key used to encrypt auth cookies and antiforgery tokens, stored in
# PLAINTEXT unless an encryptor is configured. Anyone holding one can forge or
# decrypt your cookies. Generated at runtime on first start.
DataProtectionKeys/

# Local config overrides. ASP.NET loads appsettings.*.json automatically, so
# this pattern lets you keep a private local file without risking a commit.
appsettings.*.local.json

# NOTE: .NET user-secrets are NOT listed here, because they are not in this
# folder at all. They live in %APPDATA%\Microsoft\UserSecrets\<UserSecretsId>.
# That is the point: git cannot commit what is not in the working tree.


# ---------------------------------------------------------------------------
# Runtime data this app writes into its own source tree
# ---------------------------------------------------------------------------
# LocalStorage writes uploaded media into src/Api/Storage/ — the SAME folder
# that holds the storage provider's C# source. So ignore everything in there
# except the source files. (The app writing runtime data into its own source
# tree is a design wart worth fixing later; this rule contains the damage.)
src/Api/Storage/*
!src/Api/Storage/*.cs

# IContentStorage writes lesson markdown here.
src/Api/content/

# Serilog file sink output.
src/Api/logs/

# wwwroot holds the built SPA copied in from the frontend, which is generated.
# swagger-csrf.js is hand-written source (injected at Program.cs:584), so it is
# explicitly re-included.
src/Api/wwwroot/*
!src/Api/wwwroot/swagger-csrf.js


# ---------------------------------------------------------------------------
# Test and coverage output
# ---------------------------------------------------------------------------
TestResults/
coverage/
test-results/
playwright-report/
.nyc_output/


# ---------------------------------------------------------------------------
# IDE and OS noise
# ---------------------------------------------------------------------------
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
